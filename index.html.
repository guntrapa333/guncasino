<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#0b0c12">
<title>GUN CASINO</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #0b0c12;
  --panel: #14151e;
  --panel2: #1b1d28;
  --text: #f4f5ff;
  --muted: #85899e;
  --purple: #9865ff;
  --green: #53e6a4;
  --border: rgba(255,255,255,.07);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, sans-serif;
  padding-bottom: 100px;
}

button { font: inherit; cursor: pointer; }

.app {
  max-width: 560px;
  margin: auto;
  padding: 20px 16px;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.logo {
  font-size: 23px;
  font-weight: 900;
  letter-spacing: -1px;
}

.logo span { color: var(--purple); }

.avatar {
  width: 43px;
  height: 43px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg,#a66cff,#6335db);
  font-weight: 900;
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  color: var(--muted);
  letter-spacing: 1.5px;
  font-weight: 700;
}

h1 {
  font-size: 28px;
  margin: 9px 0;
  letter-spacing: -1px;
}

.subtitle {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.hero {
  background:
    radial-gradient(ellipse at 100% 0%,rgba(153,95,255,.3),transparent 55%),
    linear-gradient(135deg,#1d1930,#14151f 75%);
  border: 1px solid rgba(164,119,255,.18);
  border-radius: 25px;
  padding: 22px;
  margin: 23px 0 17px;
  position: relative;
  overflow: hidden;
}

.hero:after {
  content: "✦";
  position: absolute;
  right: 17px;
  top: 15px;
  font-size: 75px;
  color: rgba(185,145,255,.12);
}

.balance-title {
  color: #c3b0f8;
  font-size: 12px;
  font-weight: 600;
}

.balance {
  font-size: 35px;
  font-weight: 900;
  margin: 10px 0 5px;
  letter-spacing: -1.5px;
}

.balance small {
  font-size: 15px;
  color: var(--green);
  letter-spacing: 0;
}

.balance-sub {
  color: var(--muted);
  font-size: 12px;
}

.balance-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 27px;
}

.mini-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 19px;
  padding: 16px;
  min-width: 0;
}

.coin-icon {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  margin-bottom: 14px;
  background: rgba(255,199,79,.12);
  font-size: 19px;
}

.gf-icon { background: rgba(153,101,255,.15); }

.mini-label {
  color: var(--muted);
  font-size: 11px;
  margin-bottom: 7px;
}

.mini-value {
  font-size: 19px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.mini-value.gold { color: #ffd36b; }
.mini-value.purple { color: #b99aff; }

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 27px 0 14px;
}

.section-head h2 {
  margin: 0;
  font-size: 17px;
}

.section-head span {
  color: var(--muted);
  font-size: 11px;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 9px;
}

.action {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 14px 3px;
  color: white;
  text-align: center;
}

.action .icon {
  font-size: 22px;
  margin-bottom: 9px;
}

.action div:last-child {
  font-size: 10px;
  font-weight: 600;
}

.games {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.game {
  border: 1px solid var(--border);
  background: var(--panel);
  border-radius: 20px;
  padding: 16px;
  text-align: left;
  color: white;
  min-width: 0;
  transition: .15s;
}

.game:active { transform: scale(.97); }

.game-art {
  height: 95px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-size: 39px;
  margin-bottom: 14px;
}

.art-purple { background: linear-gradient(135deg,#302050,#181526); }
.art-green { background: linear-gradient(135deg,#164b3b,#152a29); }
.art-red { background: linear-gradient(135deg,#542b38,#271823); }
.art-gold { background: linear-gradient(135deg,#514021,#282115); }
.art-blue { background: linear-gradient(135deg,#203e63,#171f34); }
.art-pink { background: linear-gradient(135deg,#522a55,#28182d); }
.art-orange { background: linear-gradient(135deg,#633b25,#302019); }

.game-name {
  font-weight: 800;
  font-size: 14px;
  margin-bottom: 6px;
}

.game-desc {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.5;
}

.badge {
  display: inline-block;
  margin-top: 11px;
  font-size: 10px;
  color: var(--green);
  background: rgba(83,230,164,.09);
  padding: 6px 9px;
  border-radius: 8px;
}

.promo {
  background: linear-gradient(110deg,#27203e,#171521);
  border: 1px solid rgba(153,101,255,.18);
  border-radius: 20px;
  padding: 19px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.promo h3 { font-size: 15px; margin: 0 0 7px; }
.promo p { font-size: 11px; color: var(--muted); margin: 0; line-height: 1.5; }

.primary {
  border: 0;
  border-radius: 12px;
  padding: 12px 15px;
  background: var(--purple);
  color: white;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.page { display: none; }
.page.active { display: block; }

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: rgba(17,18,27,.96);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--border);
  padding: 11px 5px calc(11px + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
}

.nav-inner {
  display: grid;
  grid-template-columns: repeat(5,1fr);
  width: 100%;
  max-width: 560px;
}

.nav-btn {
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 10px;
  display: grid;
  justify-items: center;
  gap: 5px;
}

.nav-btn .nav-icon { font-size: 21px; }
.nav-btn.active { color: #b99aff; }

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 19px;
  padding: 17px;
  margin-bottom: 12px;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.row + .row {
  margin-top: 15px;
  padding-top: 15px;
  border-top: 1px solid var(--border);
}

.row-title { font-size: 13px; font-weight: 700; }
.row-desc { font-size: 11px; color: var(--muted); margin-top: 5px; }

.small-btn {
  border: 1px solid var(--border);
  background: var(--panel2);
  color: white;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 11px;
  font-weight: 700;
}

input, select {
  width: 100%;
  background: var(--panel2);
  border: 1px solid var(--border);
  color: white;
  border-radius: 12px;
  padding: 13px;
  margin: 7px 0 13px;
  font: inherit;
  outline: none;
}

label { font-size: 12px; color: var(--muted); }

.full-btn {
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 13px;
  background: var(--purple);
  color: white;
  font-weight: 800;
}

.notice {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 15px;
}

.big-game-icon {
  text-align: center;
  font-size: 65px;
  margin: 25px 0;
}

.result {
  text-align: center;
  font-size: 24px;
  font-weight: 900;
  margin: 22px 0;
  min-height: 30px;
}

.toast {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translate(-50%,-150%);
  background: #262333;
  border: 1px solid #51416e;
  border-radius: 13px;
  padding: 13px 17px;
  font-size: 12px;
  z-index: 50;
  transition: .25s;
  width: max-content;
  max-width: 90%;
}

.toast.show { transform: translate(-50%,0); }

@media(min-width: 430px) {
  .game-art { height: 110px; }
}
</style>
</head>

<body>

<div class="toast" id="toast"></div>

<div class="app">

<header>
  <div class="logo">GUN<span>CASINO</span></div>
  <div class="avatar">G</div>
</header>

<!-- ГЛАВНАЯ -->
<section class="page active" id="home">

  <div class="eyebrow">ТВОЯ ИГРОВАЯ ВСЕЛЕННАЯ</div>
  <h1>Привет, игрок 👋</h1>
  <div class="subtitle">Играй, собирай бонусы и развивай свой аккаунт.</div>

  <div class="hero">
    <div class="balance-title">🟡 ТВОЙ БАЛАНС</div>
    <div class="balance" id="mainBalance">10 000 <small>GC</small></div>
    <div class="balance-sub">Твои виртуальные монеты</div>
  </div>

  <div class="balance-cards">
    <div class="mini-card">
      <div class="coin-icon">🪙</div>
      <div class="mini-label">GUNCOIN</div>
      <div class="mini-value gold" id="gcCard">10 000 GC</div>
    </div>
    <div class="mini-card">
      <div class="coin-icon gf-icon">💎</div>
      <div class="mini-label">GUNFUNTIK</div>
      <div class="mini-value purple" id="gfCard">0 GF</div>
    </div>
  </div>

  <div class="section-head">
    <h2>Быстрые действия</h2>
  </div>

  <div class="quick-actions">
    <button class="action" onclick="claimDaily()">
      <div class="icon">🎁</div><div>Бонус</div>
    </button>
    <button class="action" onclick="showPage('games')">
      <div class="icon">🎮</div><div>Игры</div>
    </button>
    <button class="action" onclick="showPage('market')">
      <div class="icon">🔄</div><div>Обмен</div>
    </button>
    <button class="action" onclick="showPage('profile')">
      <div class="icon">👤</div><div>Профиль</div>
    </button>
  </div>

  <div class="section-head">
    <h2>Попробуй удачу</h2>
    <span onclick="showPage('games')">Все игры →</span>
  </div>

  <div class="games">
    <button class="game" onclick="openGame('crash')">
      <div class="game-art art-purple">🚀</div>
      <div class="game-name">Краш</div>
      <div class="game-desc">Забери выигрыш вовремя</div>
      <span class="badge">Множитель ×</span>
    </button>

    <button class="game" onclick="openGame('dice')">
      <div class="game-art art-green">🎲</div>
      <div class="game-name">Кубик</div>
      <div class="game-desc">Испытай свою удачу</div>
      <span class="badge">Случайный результат</span>
    </button>

    <button class="game" onclick="openGame('roulette')">
      <div class="game-art art-red">🎡</div>
      <div class="game-name">Рулетка</div>
      <div class="game-desc">Числа от 0 до 36</div>
      <span class="badge">Европейская</span>
    </button>

    <button class="game" onclick="openGame('ball')">
      <div class="game-art art-blue">🔮</div>
      <div class="game-name">Шар</div>
      <div class="game-desc">Узнай свой результат</div>
      <span class="badge">Случайность</span>
    </button>
  </div>

  <div class="section-head"><h2>Твой бонус</h2></div>

  <div class="promo">
    <div>
      <h3>🎁 Ежедневная награда</h3>
      <p>Заходи каждый день и забирай GC.</p>
    </div>
    <button class="primary" onclick="claimDaily()">Забрать</button>
  </div>

</section>

<!-- ИГРЫ -->
<section class="page" id="games">
  <div class="eyebrow">ИГРОВАЯ ЗОНА</div>
  <h1>Все игры 🎮</h1>
  <div class="subtitle">Выбирай игру и испытывай удачу.</div>

  <div class="games" style="margin-top:22px">
    <button class="game" onclick="openGame('crash')">
      <div class="game-art art-purple">🚀</div>
      <div class="game-name">Краш</div>
      <div class="game-desc">Поймай множитель</div>
    </button>
    <button class="game" onclick="openGame('dice')">
      <div class="game-art art-green">🎲</div>
      <div class="game-name">Кубик</div>
      <div class="game-desc">Угадай результат</div>
    </button>
    <button class="game" onclick="openGame('roulette')">
      <div class="game-art art-red">🎡</div>
      <div class="game-name">Рулетка 0–36</div>
      <div class="game-desc">Числа, красное и чёрное</div>
    </button>
    <button class="game" onclick="openGame('ball')">
      <div class="game-art art-blue">🔮</div>
      <div class="game-name">Шар</div>
      <div class="game-desc">Случайный результат</div>
    </button>
    <button class="game" onclick="openGame('coin')">
      <div class="game-art art-gold">🪙</div>
      <div class="game-name">Монета</div>
      <div class="game-desc">Орёл или решка</div>
    </button>
    <button class="game" onclick="openGame('slots')">
      <div class="game-art art-pink">🎰</div>
      <div class="game-name">Слоты</div>
      <div class="game-desc">Собери комбинацию</div>
    </button>
    <button class="game" onclick="openGame('mines')">
      <div class="game-art art-orange">💣</div>
      <div class="game-name">Мины</div>
      <div class="game-desc">Открывай безопасные клетки</div>
    </button>
  </div>
</section>

<!-- КОШЕЛЁК -->
<section class="page" id="wallet">
  <div class="eyebrow">ТВОИ СРЕДСТВА</div>
  <h1>Кошелёк 💰</h1>
  <div class="subtitle">Две валюты — одна игровая экономика.</div>

  <div class="panel" style="margin-top:22px">
    <div class="row">
      <div>
        <div class="row-title">🟡 Guncoin</div>
        <div class="row-desc">Основная игровая валюта</div>
      </div>
      <strong class="mini-value gold" id="walletGC">10 000</strong>
    </div>
    <div class="row">
      <div>
        <div class="row-title">💎 Gunfuntik</div>
        <div class="row-desc">Вторая игровая валюта</div>
      </div>
      <strong class="mini-value purple" id="walletGF">0</strong>
    </div>
  </div>

  <div class="section-head"><h2>Операции</h2></div>

  <div class="panel">
    <div class="row">
      <div><div class="row-title">🎁 Ежедневный бонус</div>
      <div class="row-desc">Получай бесплатные GC</div></div>
      <button class="small-btn" onclick="claimDaily()">Забрать</button>
    </div>
    <div class="row">
      <div><div class="row-title">🔄 Обмен валют</div>
      <div class="row-desc">Официальный обменник и P2P</div></div>
      <button class="small-btn" onclick="showPage('market')">Открыть</button>
    </div>
    <div class="row">
      <div><div class="row-title">💎 Магазин</div>
      <div class="row-desc">GF, VIP и оформление профиля</div></div>
      <button class="small-btn" onclick="showPage('shop')">Открыть</button>
    </div>
  </div>

  <div class="notice">Баланс этой демонстрационной версии хранится в браузере. Он ещё не подключён к настоящему игровому серверу.</div>
</section>

<!-- ОБМЕН -->
<section class="page" id="market">
  <div class="eyebrow">ИГРОВАЯ ЭКОНОМИКА</div>
  <h1>Обмен 🔄</h1>
  <div class="subtitle">Официальный обменник и рынок между игроками.</div>

  <div class="section-head"><h2>Официальный обменник</h2></div>

  <div class="panel">
    <div class="row">
      <div><div class="row-title">🟢 Купить GF</div>
      <div class="row-desc">1 GF = 1 050 GC · демо-курс</div></div>
    </div>
    <label>Количество GF</label>
    <input type="number" id="buyAmount" min="1" placeholder="Например, 10">
    <button class="full-btn" onclick="officialBuy()">Купить за GC</button>

    <div class="row" style="margin-top:20px">
      <div><div class="row-title">🔴 Продать GF</div>
      <div class="row-desc">1 GF = 950 GC · демо-курс</div></div>
    </div>
    <label>Количество GF</label>
    <input type="number" id="sellAmount" min="1" placeholder="Например, 10">
    <button class="full-btn" onclick="officialSell()">Продать за GC</button>
  </div>

  <div class="section-head"><h2>P2P-рынок</h2></div>

  <div class="panel">
    <div class="row-title">🤝 Обмен между игроками</div>
    <div class="row-desc">Игроки смогут размещать предложения и принимать чужие.</div>
    <p class="notice">P2P пока находится в разработке. Для настоящих сделок понадобится сервер, который безопасно блокирует валюту на время предложения и проводит обмен атомарно.</p>
    <button class="full-btn" onclick="toast('P2P подключим на следующем этапе')">Скоро откроется</button>
  </div>
</section>

<!-- ПРОФИЛЬ -->
<section class="page" id="profile">
  <div class="eyebrow">ТВОЙ АККАУНТ</div>
  <h1>Профиль 👤</h1>

  <div class="panel" style="text-align:center;padding:25px">
    <div class="avatar" style="margin:auto;width:65px;height:65px;font-size:25px">G</div>
    <h2 style="margin-bottom:5px">Игрок GUN CASINO</h2>
    <div class="subtitle">Уровень 1 · Новичок</div>
    <div class="badge">✦ Начало пути</div>
  </div>

  <div class="balance-cards">
    <div class="mini-card">
      <div class="mini-label">ТЕКУЩИЙ УРОВЕНЬ</div>
      <div class="mini-value">1</div>
    </div>
    <div class="mini-card">
      <div class="mini-label">ДНЕЙ С БОТОМ</div>
      <div class="mini-value" id="daysCount">1</div>
    </div>
  </div>

  <div class="panel">
    <div class="row">
      <div><div class="row-title">🏆 Достижения</div><div class="row-desc">Награды за прогресс</div></div>
      <span>🔒</span>
    </div>
    <div class="row">
      <div><div class="row-title">👑 VIP-статус</div><div class="row-desc">Особый статус игрока</div></div>
      <button class="small-btn" onclick="showPage('shop')">Подробнее</button>
    </div>
    <div class="row">
      <div><div class="row-title">📊 Статистика</div><div class="row-desc">История операций появится позже</div></div>
      <span>→</span>
    </div>
  </div>
</section>

<!-- МАГАЗИН -->
<section class="page" id="shop">
  <div class="eyebrow">МАГАЗИН</div>
  <h1>Магазин 💎</h1>
  <div class="subtitle">Виртуальные товары и оформление.</div>

  <div class="panel" style="margin-top:22px">
    <div class="row">
      <div><div class="row-title">💎 Gunfuntik</div><div class="row-desc">Внутриигровая валюта</div></div>
      <span>GF</span>
    </div>
    <div class="row">
      <div><div class="row-title">👑 VIP</div><div class="row-desc">Особый значок профиля</div></div>
      <span>VIP</span>
    </div>
    <div class="row">
      <div><div class="row-title">🎨 Оформление</div><div class="row-desc">Украшения игрового профиля</div></div>
      <span>✦</span>
    </div>
    <div class="notice">Это макет магазина. Реальные покупки пока не подключены.</div>
  </div>
</section>

<!-- ИГРОВОЙ ЭКРАН -->
<section class="page" id="play">
  <button class="small-btn" onclick="showPage('games')">← Все игры</button>
  <div id="playContent"></div>
</section>

</div>

<nav class="bottom-nav">
  <div class="nav-inner">
    <button class="nav-btn active" data-page="home" onclick="showPage('home')">
      <span class="nav-icon">⌂</span><span>Главная</span>
    </button>
    <button class="nav-btn" data-page="games" onclick="showPage('games')">
      <span class="nav-icon">🎮</span><span>Игры</span>
    </button>
    <button class="nav-btn" data-page="wallet" onclick="showPage('wallet')">
      <span class="nav-icon">💰</span><span>Кошелёк</span>
    </button>
    <button class="nav-btn" data-page="market" onclick="showPage('market')">
      <span class="nav-icon">🔄</span><span>Обмен</span>
    </button>
    <button class="nav-btn" data-page="profile" onclick="showPage('profile')">
      <span class="nav-icon">👤</span><span>Профиль</span>
    </button>
  </div>
</nav>

<script>
const STORE_KEY = "guncasino_demo_v1";

let state = {
  gc: 10000,
  gf: 0,
  lastDaily: "",
  streak: 0,
  days: 1,
  plays: 0
};

try {
  const saved = JSON.parse(localStorage.getItem(STORE_KEY));
  if (saved) state = {...state, ...saved};
} catch(e) {}

function save() {
  localStorage.setItem(STORE_KEY, JSON.stringify(state));
  updateUI();
}

function fmt(n) {
  return Math.floor(n).toLocaleString("ru-RU");
}

function updateUI() {
  document.getElementById("mainBalance").innerHTML =
    fmt(state.gc) + ' <small>GC</small>';
  document.getElementById("gcCard").textContent = fmt(state.gc) + " GC";
  document.getElementById("gfCard").textContent = fmt(state.gf) + " GF";
  document.getElementById("walletGC").textContent = fmt(state.gc);
  document.getElementById("walletGF").textContent = fmt(state.gf);
  document.getElementById("daysCount").textContent = state.days;
}

function toast(message) {
  const el = document.getElementById("toast");
  el.textContent = message;
  el.classList.add("show");
  clearTimeout(window.toastTimer);
  window.toastTimer = setTimeout(() => el.classList.remove("show"), 2500);
}

function showPage(page) {
  document.querySelectorAll(".page").forEach(el => {
    el.classList.toggle("active", el.id === page);
  });

  document.querySelectorAll(".nav-btn").forEach(el => {
    el.classList.toggle("active", el.dataset.page === page);
  });

  window.scrollTo(0, 0);
}

function claimDaily() {
  const today = new Date().toDateString();

  if (state.lastDaily === today) {
    toast("Бонус уже получен сегодня!");
    return;
  }

  state.gc += 500;
  state.lastDaily = today;
  state.streak += 1;

  save();
  toast("Получено 500 GC!");
}

function officialBuy() {
  const input = document.getElementById("buyAmount");
  const amount = Math.floor(Number(input.value));

  if (!Number.isFinite(amount) || amount <= 0) {
    toast("Введи правильное количество GF");
    return;
  }

  const cost = amount * 1050;

  if (state.gc < cost) {
    toast("Недостаточно GC");
    return;
  }

  state.gc -= cost;
  state.gf += amount;

  save();
  input.value = "";
  toast("Обмен выполнен!");
}

function officialSell() {
  const input = document.getElementById("sellAmount");
  const amount = Math.floor(Number(input.value));

  if (!Number.isFinite(amount) || amount <= 0) {
    toast("Введи правильное количество GF");
    return;
  }

  if (state.gf < amount) {
    toast("Недостаточно GF");
    return;
  }

  state.gf -= amount;
  state.gc += amount * 950;

  save();
  input.value = "";
  toast("Обмен выполнен!");
}

function openGame(name) {
  showPage("play");

  const games = {
    crash: ["🚀", "Краш"],
    dice: ["🎲", "Кубик"],
    roulette: ["🎡", "Рулетка"],
    ball: ["🔮", "Шар"],
    coin: ["🪙", "Монета"],
    slots: ["🎰", "Слоты"],
    mines: ["💣", "Мины"]
  };

  const game = games[name];

  document.getElementById("playContent").innerHTML = `
    <h1>${game[1]}</h1>
    <div class="big-game-icon">${game[0]}</div>
    <div class="panel">
      <div class="row-title">Демо-режим</div>
      <p class="notice">
        Здесь пока доступен только интерфейс.
        Игровая механика будет добавлена отдельно.
      </p>
      <button class="full-btn"
        onclick="toast('Эта игра пока в разработке')">
        Играть
      </button>
    </div>
  `;
}

updateUI();
</script>

</body>
</html>